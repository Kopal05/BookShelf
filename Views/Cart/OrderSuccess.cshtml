@{
    ViewData["Title"] = "OrderSuccess";
}

<div class="container my-5">

    <!-- Success Card -->
    <div class="card shadow-sm border-0 rounded-4 p-4 mx-auto" style="max-width: 600px;">

        <div class="text-center">

            <!-- Success Icon -->
            <div class="mx-auto mb-3" style="width: 80px; height: 80px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80"
                     fill="none" viewBox="0 0 24 24" stroke="green" stroke-width="1.5">
                    <circle cx="12" cy="12" r="10" stroke="green" stroke-width="1.2" />
                    <path stroke-linecap="round" stroke-linejoin="round" 
                          d="M8 12.5l2.5 2.5 5.5-6" stroke="green" stroke-width="2" />
                </svg>
            </div>

            <!-- Title -->
            <h1 class="h3 fw-bold mb-2 text-success">Order Successful!</h1>

            <!-- Message -->
            <p class="text-muted mb-4">
                Thank you for your purchase. Your order has been placed successfully.<br />
                Your order will be delivered soon.
            </p>

            <!-- Continue Button -->
            <a href="/" class="btn btn-primary btn-lg rounded-3 px-4 shadow-sm">
                Continue Shopping
            </a>

            <!-- Optional: View Orders -->
            <div class="mt-3">
                <a href="/UserOrder/UserOrders" class="text-decoration-none fw-semibold">
                    View My Orders →
                </a>
            </div>

        </div>

    </div>

</div>

<style>
    .text-success {
        color: #198754 !important;
    }
</style>