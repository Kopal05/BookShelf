<section class="img-container">
    <div class="viewbook-container py-4">

        <div class="row g-4">

            <!-- LEFT: PRODUCT IMAGE -->
            <div class="col-md-4 sticky-col">

                <div class="card shadow-sm border-0 p-3 text-center">
                    @if (string.IsNullOrEmpty(Model.Image))
                    {
                        <img class="img-fluid rounded" style="height:73vh;object-fit:cover" src="/images/book-cover/NoBookCover.png" alt="..." />
                    }
                    else
                    {
                        <img class="img-fluid rounded" style="height:73vh;object-fit:cover" src="/images/book-cover/@Model.Image" alt="..." />
                    }
                </div>

            </div>

            <!-- RIGHT: PRODUCT DETAILS -->
            <div class="col-md-8">

                <div class="card border-0 p-4 shadow-sm">

                    <!-- Book Title -->
                    <h2 class="fw-bold mb-1">@Model.BookName</h2>

                    <!-- Meta -->
                    <p class="text-muted mb-3">
                        <span><strong>Genre:</strong> @Model.Genre?.GenreName</span> &nbsp;•&nbsp;
                        <span><strong>Author:</strong> @Model.AuthorName</span>
                    </p>

                    @* @if (!string.IsNullOrEmpty(Model.Quote))
                    {

                        <pre class="quote-box">     @Model.Quote</pre>

                    } *@

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <hr />
                        <p class="description">@Model.Description</p>
                    }

                    <hr />

                    <!-- Price & Stock -->
                    <div class="mb-3">
                        <h3 class="text-primary fw-bold">₹@Model.Price</h3>

                        @if (Model.Stock?.Quantity > 0)
                        {
                            <span class="badge bg-success">In Stock</span>
                            <span class="text-muted ms-2">( @Model.Stock.Quantity left )</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Out of Stock</span>
                        }
                    </div>

                    <hr />

                    <!-- Add to Cart Button -->
                    <div class="mt-3">
                        @if (Model.Stock?.Quantity > 0)
                        {
                            <button type="button" onclick="add(@Model.Id)"
                                    class="btn btn-primary btn-lg px-4 ui-btn">
                                <i class="bi bi-cart-plus"></i> Add to Cart
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-outline-danger btn-lg px-4" disabled>
                                Out of Stock
                            </button>
                        }
                    </div>

                </div>

            </div>

        </div>

    </div>
</section>

@section Scripts {
    <script>
        async function add(bookId) {
            var usernameEl = document.getElementById("username");

            if(usernameEl==null){
                window.location.href = "/Identity/Account/Login";
            }

            try {
                var response = await fetch(`/Cart/AddItem?bookId=${bookId}`);
                if (response.status == 200) {
                    var result = await response.json();
                    var cartCountEl = document.getElementById("cartCount");
                    cartCountEl.innerHTML = result;
                    window.location.href = "#nav";
                }
            }
            catch (err) {
                console.log(err);
            }
        }
    </script>
}
