<section id="book-section">
    <div class="my-2">
        <form asp-action="Index" method="get" class="row row-cols-lg-auto g-3 align-items-center justify-content-center">
            <div class="col-12">
                <label class="visually-hidden" for="genreId">All Genres</label>
                <select class="form-select" id="genreId" name="genreId">
                    <option selected>All Genres</option>
                    @foreach (var genre in Model.Genres)
                    {
                        <option selected="@(genre.Id == Model.GenreId)" value="@genre.Id">@genre.GenreName</option>
                    }
                </select>
            </div>

            <div class="col-12">
                <label class="visually-hidden" for="sterm">Search by title</label>
                <div class="input-group">
                    <input type="text" class="form-control" value="@Model.STerm" id="sterm" name="sterm" placeholder="Search by title">
                </div>
            </div>

            <div class="col-12">
                <button type="submit" class="btn btn-primary ui-btn">Search</button>
                <a href="/Home/Index" class="btn btn-dark">Reset</a>
            </div>
        </form>
    </div>

    <div class="card-outer w-100 mt-4 d-flex flex-wrap justify-content-center">
        @foreach (var book in Model.Books)
        {
            <a class="text-decoration-none mx-3 mb-4 card overflow-hidden rounded-3" href="/book/ViewBook/@book.Id">
                    <div class="book-thumbnail">
                        @if (string.IsNullOrEmpty(book.Image))
                        {
                            <img style="width:100%;" src="/images/book-cover/NoBookCover.png" class="" alt="...">
                        }
                        else
                        {
                            <img class="pe-3 pt-3 ps-3" style="width:100%;" src="/images/book-cover/@book.Image" alt="...">
                        }
                    </div>
                    <div class="card-body">
                        <p class="additional-info card-text text-center fst-italic">
                            <b>by @book.AuthorName <br /></b>
                        </p>
                        <h5 class="card-text fs-6 fw-bolder text-nowrap text-truncate text-center text-black">@book.BookName</h5>

                    </div>
            </a>
        }
    </div>
</section>




